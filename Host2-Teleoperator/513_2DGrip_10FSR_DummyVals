### Intermediate coordinates maker
def intermediates(p1, p2, nb_points=8):
    """"Return a list of nb_points equally spaced points
    between p1 and p2"""
    # If we have 8 intermediate points, we have 8+1=9 spaces
    # between p1 and p2
    x_spacing = (p2[0] - p1[0]) / (nb_points + 1)
    y_spacing = (p2[1] - p1[1]) / (nb_points + 1)
    z_spacing = (p2[2] - p1[2]) / (nb_points + 1)


    coord_list = [[p1[0] + i * x_spacing, p1[1] + i * y_spacing, p1[2] + i * z_spacing]
            for i in range(1, nb_points + 1)]

    pose_list = [geometry_msgs.Pose(geometry_msgs.Vector3(p1[0], p1[1], p1[2]), geometry_msgs.Quaternion(qx, qy, qz, qw))]
    i = 1
    while (i < len(coord_list)):
        pose_list.append(geometry_msgs.Pose(geometry_msgs.Vector3(coord_list[i][0], coord_list[i][1], coord_list[i][2]), geometry_msgs.Quaternion(qx, qy, qz, qw)))
        i = i + 1

    return(pose_list)
