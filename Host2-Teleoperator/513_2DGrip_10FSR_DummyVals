    df_out.drop(['x1', 'y1', 'x2', 'y2', 'key' ,'fsr1', 'fsr2','angle'], axis=1, inplace=True)  # dropping unwanted columns
    match_dict = df_out.set_index('key_fsr').T.to_dict('list')  # Converting to dictionary
    return (match_dict)

def correction_out(high_fsrs):
    key_to_search = str(high_fsrs)
    # print(key_to_search)
    correction = match_dict.get(key_to_search)  # getting the correction values using get method in dictionary
    return(correction)

### Defining a custom fuction to convert Euler Angles to Quaternion
### This works only on the plane parallel to the whiteboard
def custom_e2q01(angle_deg):
    qx = 0.707106781
    qy = qx
    qz = float(angle_deg)/90*qx
    qw = qz
    return (qx,qy,qz,qw)


