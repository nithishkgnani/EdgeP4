def array_out_load():
    df_out = pd.read_csv("/home/zenlab/catkin_ws/src/Universal_Robots_ROS_Driver/ur_robot_driver/scripts/array_out_03.csv",
                         dtype=str)  # used dtype=str to ensure 0011 is not imported as 11 (float64 default conversion)
